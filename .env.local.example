# Copy this file to .env.local (gitignored) and fill in your own token.
# Get a free one at https://www.themoviedb.org/settings/api — sign up,
# then Settings > API > request access (choose "Developer"). Use the
# "API Read Access Token" (a long JWT), not the shorter v3 "API Key".
VITE_TMDB_ACCESS_TOKEN=
